{
  "name": "apex-garage",
  "version": "0.0.0",
  "private": true,
  "description": "Apex Garage: a car-themed, self-hosted web app for car enthusiasts, with the Crew Chief AI assistant.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter @apex/api --filter @apex/web dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --parallel --filter @apex/api --filter @apex/web start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json && pnpm --recursive typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "echo 'db:migrate: not available yet. Database migrations arrive with playbook instruction 26.' >&2; exit 1",
    "db:seed": "echo 'db:seed: not available yet. The seed script arrives with playbook instruction 26.' >&2; exit 1",
    "docker:up": "node scripts/check-docker.ts && docker compose up --detach --wait",
    "docker:down": "node scripts/check-docker.ts && docker compose down",
    "docker:logs": "node scripts/check-docker.ts && docker compose logs --follow"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "catalog:",
    "eslint": "^9.39.5",
    "eslint-config-next": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "next": "catalog:",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1",
    "vitest": "catalog:",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  }
}
