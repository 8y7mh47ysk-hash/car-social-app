# Environment files hold settings and secrets: only the .env.example templates are committed.
# Next.js, Node.js and Docker Compose read .env and .env.*; files for Docker's --env-file and
# Compose's env_file are usually named *.env, and direnv reads .envrc. env-files.test.ts checks
# these rules.
*.env
.envrc
.env
.env.*
!.env.example

# Tool caches and OS files
.turbo/
.eslintcache
.DS_Store
*.log

# The owner's knowledge-graph tool writes here
graphify-out/
