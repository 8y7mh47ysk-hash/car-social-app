{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Compiles src/ to dist/ for plain Node.js at runtime (see the "@apex/dist" export condition).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
