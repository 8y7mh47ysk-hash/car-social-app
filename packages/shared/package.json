{
  "name": "@apex/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas, types and helpers shared by the Apex Garage apps.",
  "type": "module",
  "exports": {
    ".": {
      "@apex/dist": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
