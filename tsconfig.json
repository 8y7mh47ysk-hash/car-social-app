{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-checks the TypeScript files at the repository root: tool configs and the tests for the
  // git hooks. Each workspace package has its own tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["*.ts"]
}
