{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-checks the TypeScript config files at the repository root. Each workspace package
  // has its own tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["*.ts"]
}
