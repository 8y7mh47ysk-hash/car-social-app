{
  "name": "@apex/api",
  "version": "0.0.0",
  "private": true,
  "description": "Apex Garage HTTP API (Fastify).",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output src/server.ts",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "start": "node --conditions=@apex/dist --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apex/shared": "workspace:*",
    "fastify": "^5.12.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pino-pretty": "^13.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
