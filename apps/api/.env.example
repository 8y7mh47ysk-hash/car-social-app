# Template for apps/api/.env, which the API reads when it starts with `pnpm dev` or `pnpm start`.
# Copy it only if you want to change a setting:
#
#   cp apps/api/.env.example apps/api/.env
#
# .env is gitignored; never commit it. Variables already set in the shell win over the file.
# Keep to plain NAME=value lines. Every variable here is optional: the commented-out value is the
# default. If a variable is missing or invalid, the API refuses to start and names it (it never
# prints values).

# Interface the API listens on: an IP address or a hostname. 127.0.0.1 means this machine only.
# Use 0.0.0.0 only when the API must be reachable from other machines, such as inside a container.
# API_HOST=127.0.0.1

# TCP port, 0 to 65535 (0 lets the operating system pick a free one).
# API_PORT=4000

# Lowest log level written: fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info
