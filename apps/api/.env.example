# Template for apps/api/.env, which the API reads when it starts with `pnpm dev` or `pnpm start`.
# Copy it only if you want to change a setting, and make the copy readable by your user only,
# because settings can include secrets:
#
#   cp apps/api/.env.example apps/api/.env && chmod 600 apps/api/.env
#
# .env is gitignored; never commit it. Variables already set in the shell, even to an empty
# value, win over the file. Keep to plain NAME=value lines, and note that a # ends a value even
# without a space before it. Every variable here is optional: the commented-out value is the
# default. If a variable is missing or invalid, the API refuses to start and names it (it never
# prints values).

# Interface the API listens on: an IP address or a hostname. 127.0.0.1 means this machine only.
# Use 0.0.0.0 only when the API must be reachable from other machines, such as inside a container.
# API_HOST=127.0.0.1

# TCP port, 0 to 65535 (0 lets the operating system pick a free one).
# API_PORT=4000

# Lowest log level written: fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info

# Log output: json (one JSON object per line; for production and log tools) or pretty (readable
# lines for a developer's terminal; needs the development dependencies, so not in production).
# LOG_FORMAT=json
