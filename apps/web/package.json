{
  "name": "@apex/web",
  "version": "0.0.0",
  "private": true,
  "description": "Apex Garage web app (Next.js).",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname \"${WEB_HOST:-127.0.0.1}\" --port \"${WEB_PORT:-3000}\"",
    "build": "next build",
    "start": "next start --hostname \"${WEB_HOST:-127.0.0.1}\" --port \"${WEB_PORT:-3000}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apex/shared": "workspace:*",
    "next": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
